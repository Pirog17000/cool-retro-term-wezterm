+    /// The settings (gear) title bar button: emits `settings-button-click`
+    /// (window, pane).  When no handler is registered, or a handler returns
+    /// something other than `false`, the command palette is opened.
+    fn do_settings_button_click(&mut self) {
+        let pane = match self.get_active_pane_or_overlay() {
+            Some(pane) => pane,
+            None => return,
+        };
+
+        async fn dispatch_settings_button(
+            lua: Option<Rc<mlua::Lua>>,
+            window: GuiWin,
+            pane: MuxPane,
+        ) -> anyhow::Result<()> {
+            let default_action = match lua {
+                Some(lua) => {
+                    let args = lua.pack_multi((window.clone(), pane))?;
+                    config::lua::emit_event(&lua, ("settings-button-click".to_string(), args))
+                        .await
+                        .map_err(|e| {
+                            log::error!("while processing settings-button-click event: {:#}", e);
+                            e
+                        })?
+                }
+                None => true,
+            };
+            if default_action {
+                window.window.notify(TermWindowNotif::PerformAssignment {
+                    pane_id: pane.0,
+                    assignment: KeyAssignment::ActivateCommandPalette,
+                    tx: None,
+                });
+            }
+            Ok(())
+        }
+        let window = GuiWin::new(self);
+        let pane = MuxPane(pane.pane_id());
+        promise::spawn::spawn(config::with_lua_config_on_main_thread(move |lua| {
+            dispatch_settings_button(lua, window, pane)
+        }))
+        .detach();
+    }
+
     pub fn mouse_event_tab_bar(
         &mut self,
         item: TabBarItem,
@@ -510,6 +553,7 @@ impl super::TermWindow {
                                 }
                             }
                             Button::Close => self.close_requested(&window.clone()),
+                            Button::Settings => self.do_settings_button_click(),
                         }
                     }
                 }
