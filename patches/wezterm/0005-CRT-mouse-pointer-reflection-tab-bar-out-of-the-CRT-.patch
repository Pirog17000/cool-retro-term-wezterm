+/// WEZTERM_CRT_DEBUG_POINTER="x,y" or "x,y,text": a pointer position in
+/// window pixels (arrow, or I-beam with ",text") used instead of the real
+/// mouse, so the pointer reflection can be captured in screenshots and tests.
+fn crt_debug_pointer() -> Option<(f32, f32, i32)> {
+    static DEBUG: std::sync::OnceLock<Option<(f32, f32, i32)>> = std::sync::OnceLock::new();
+    *DEBUG.get_or_init(|| {
+        let v = std::env::var("WEZTERM_CRT_DEBUG_POINTER").ok()?;
+        let mut it = v.split(',').map(str::trim);
+        let x = it.next()?.parse().ok()?;
+        let y = it.next()?.parse().ok()?;
+        let kind = if it.next() == Some("text") { 2 } else { 1 };
+        Some((x, y, kind))
+    })
+}
