+/// Size of the mouse pointer at 96 dpi: the pointer size chosen in the
+/// Windows accessibility settings (CursorBaseSize, 32 by default).  Read
+/// again every few seconds, the setting can change at any time.
+fn crt_cursor_base_size() -> f32 {
+    #[cfg(windows)]
+    {
+        use std::cell::Cell;
+        use std::time::{Duration, Instant};
+        thread_local! {
+            static CACHE: Cell<Option<(Instant, f32)>> = Cell::new(None);
+        }
+        if let Some((at, size)) = CACHE.with(|c| c.get()) {
+            if at.elapsed() < Duration::from_secs(2) {
+                return size;
+            }
+        }
+        let size = winreg::RegKey::predef(winreg::enums::HKEY_CURRENT_USER)
+            .open_subkey("Control Panel\\Cursors")
+            .and_then(|k| k.get_value::<u32, _>("CursorBaseSize"))
+            .map(|v| v as f32)
+            .unwrap_or(32.0)
+            .clamp(16.0, 512.0);
+        CACHE.with(|c| c.set(Some((Instant::now(), size))));
+        size
+    }
+    #[cfg(not(windows))]
+    {
+        32.0
+    }
+}
