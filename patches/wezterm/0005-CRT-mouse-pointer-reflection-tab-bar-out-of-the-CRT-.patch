 vec2 distortCoordinates(vec2 coords) {
     vec2 paddedCoords = coords * (vec2(1.0) + frameSize * 2.0) - frameSize;
@@ -159,13 +206,15 @@ void main() {
     float isScreen = 1.0;
 
     vec2 txt_coords = tc;
+    vec2 curvatureCoords = tc;
     if (curvatureOn > 0.5) {
-        vec2 curvatureCoords = distortCoordinates(tc);
-        shownDraw = max2(step(vec2(0.0), curvatureCoords) - step(vec2(1.0), curvatureCoords));
+        curvatureCoords = distortCoordinates(tc);
         isScreen = min2(step(vec2(0.0), curvatureCoords) - step(vec2(1.0), curvatureCoords));
         isReflection = shownDraw - isScreen;
-        txt_coords = curvatureCoords * (-1.0 + 2.0 * step(vec2(0.0), curvatureCoords)
-                                       - 2.0 * step(vec2(1.0), curvatureCoords));
+        // The bezel shows the content mirrored through the nearest point of
+        // the screen: at an edge that is the edge, in a corner the corner
+        // itself.  (cool-retro-term leaves the corners empty.)
+        txt_coords = vec2(1.0) - abs(vec2(1.0) - abs(curvatureCoords));
     }
 
     vec3 txt_color = tx(source, txt_coords).rgb;
@@ -201,6 +250,41 @@ void main() {
         finalColor = mix(finalColor, reflectionColor, isReflection);
     }
 
+    // The mouse pointer is mirrored in the bezel too.  The bezel is taken as
+    // a curved frame with rounded corners (radius pointerCorner): along an
+    // edge the mirror is flat, around a corner it is radial from the centre
+    // of the rounding, so the image wraps around the corner.  The pointer floats above the glass, so its
+    // image starts pointerLift further out; the bezel slopes away, so the
+    // image is squeezed across the edge; and the bezel is curved like the
+    // screen, so the ends of the image lean back towards the screen.
+    if (pointerKind > 0 && isReflection > 0.5) {
+        const float FORESHORTEN = 0.55;
+        const float BEND = 1.6;
+        vec2 cpx = curvatureCoords * viewportSize;
+        vec2 ppx = pointerPos * viewportSize;
+        float rc = min(pointerCorner, 0.5 * min2(viewportSize));
+        vec2 inner = clamp(cpx, vec2(rc), viewportSize - vec2(rc));
+        vec2 v = cpx - inner;
+        float rv = max(length(v), 1e-4);
+        vec2 n = v / rv;                     // outwards
+        vec2 t = vec2(-n.y, n.x);            // along the edge
+        // the mirror line is the screen edge itself (as for the text); in a
+        // corner it is crossed radially, so the corner is not cut off
+        float r0 = rc / max(max2(abs(n)), 1e-4);
+        float d = rv - r0;                   // distance out from the edge
+        vec2 centre = pointerCentre(pointerKind);
+        float s = dot(ppx + centre * pointerSize - inner, t) / pointerSize;
+        float depth = (d - pointerLift) / FORESHORTEN + BEND * s * s * pointerSize;
+        vec2 world = inner + n * (r0 - depth);
+        vec2 pp = (world - ppx) / pointerSize;
+        // further out the bezel is rougher: softer and fainter; a corner
+        // only mirrors what is within its radius
+        float far = clamp(d / pointerSize, 0.0, 1.0);
+        float corner = step(1e-3, min2(abs(v)));
+        float weight = (1.0 - 0.5 * far) * (1.0 - corner * smoothstep(0.8, 1.0, depth / max(r0, 1.0)));
+        finalColor += vec3(pointerShape(pp, pointerKind, 0.10 + 0.08 * far)) * pointerFrame * weight;
+    }
+
     finalColor *= screen_brightness;
 
     float noise = rand2(tc) - 0.5;
@@ -270,6 +354,14 @@ uniform vec2 aspectScale;  // bulge per axis: the same displacement in pixels on
 uniform float bloom;
 uniform float frameOn;
 uniform float tintOn;
+uniform vec2 viewportSize;
+uniform vec2 pointerPos;     // pointer position on the screen, 0..1
+uniform float pointerSize;   // cursor box in pixels
+uniform int pointerKind;     // 0 = none
+uniform float pointerGlass;  // strength of the reflection in the glass
+uniform float pointerShift;  // pull towards the centre (convex glass)
+uniform float pointerBend;   // how much the image bends around the bulge
+uniform float pointerSqueeze; // how much it is squeezed along the radius
 
 vec2 distortCoordinates(vec2 coords) {
     vec2 paddedCoords = coords * (vec2(1.0) + frameSize * 2.0) - frameSize;
@@ -379,5 +471,26 @@ void main() {
         finalColor = mix(finalColor, frameColor.rgb, frameColor.a);
     }
 
+    // Reflection of the mouse pointer in the convex glass, the further from
+    // the centre the stronger: pulled towards the centre, squeezed along the
+    // radius and bent into an arc around the bulge (its ends lag towards the
+    // centre, like straight lines on the curved screen).
+    if (pointerKind > 0) {
+        vec2 px = (tc - vec2(0.5)) * viewportSize;          // pixels from the centre
+        vec2 ghost = (pointerPos - vec2(0.5)) * viewportSize * (1.0 - pointerShift);
+        float glen = length(ghost);
+        float r = glen / (0.25 * (viewportSize.x + viewportSize.y));
+        vec2 radial = glen > 1.0 ? ghost / glen : vec2(1.0, 0.0);
+        vec2 tangent = vec2(-radial.y, radial.x);
+        vec2 centre = pointerCentre(pointerKind);
+        vec2 l = (px - ghost) / pointerSize - centre;
+        float lr = dot(l, radial);
+        float lt = dot(l, tangent);
+        lr = (lr + pointerBend * r * lt * lt) * (1.0 + pointerSqueeze * r);
+        vec2 pp = radial * lr + tangent * lt + centre;
+        float onGlass = min2(step(vec2(0.0), staticCoords) - step(vec2(1.0), staticCoords));
+        finalColor += vec3(pointerShape(pp, pointerKind, 0.12)) * pointerGlass * onGlass;
+    }
+
     color = vec4(finalColor, 1.0);
 }
