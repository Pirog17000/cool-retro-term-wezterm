diff --git a/wezterm-gui/src/crt/shaders.glsl b/wezterm-gui/src/crt/shaders.glsl
index 4152060..7636691 100644
--- a/wezterm-gui/src/crt/shaders.glsl
+++ b/wezterm-gui/src/crt/shaders.glsl
@@ -18,6 +18,46 @@ float prod2(vec2 v) { return v.x * v.y; }
 float rgb2grey(vec3 v) { return dot(v, vec3(0.21, 0.72, 0.04)); }
 float rand2(vec2 v) { return fract(sin(dot(v, vec2(12.9898, 78.233))) * 43758.5453); }
 
+// Mouse pointer shapes for the pointer reflection.  Signed distances in
+// pointer units: the cursor box is 1 x 1, the origin is the hotspot, y down.
+float sdBox(vec2 p, vec2 b) {
+    vec2 d = abs(p) - b;
+    return length(max(d, vec2(0.0))) + min(max(d.x, d.y), 0.0);
+}
+float sdIBeam(vec2 p) {
+    float stem = sdBox(p, vec2(0.035, 0.28));
+    float top = sdBox(p - vec2(0.0, -0.27), vec2(0.14, 0.03));
+    float bottom = sdBox(p - vec2(0.0, 0.27), vec2(0.14, 0.03));
+    return min(stem, min(top, bottom));
+}
+float sdArrow(vec2 p) {
+    // the classic arrow, tip at the hotspot, in 1/32 of the cursor box
+    vec2 v[7] = vec2[7](vec2(0.0, 0.0), vec2(0.0, 17.0), vec2(4.0, 13.0), vec2(7.0, 20.0),
+                        vec2(9.5, 19.0), vec2(6.5, 12.0), vec2(11.5, 12.0));
+    p *= 32.0;
+    float d = dot(p - v[0], p - v[0]);
+    float s = 1.0;
+    for (int i = 0, j = 6; i < 7; j = i, i++) {
+        vec2 e = v[j] - v[i];
+        vec2 w = p - v[i];
+        vec2 b = w - e * clamp(dot(w, e) / dot(e, e), 0.0, 1.0);
+        d = min(d, dot(b, b));
+        bvec3 c = bvec3(p.y >= v[i].y, p.y < v[j].y, e.x * w.y > e.y * w.x);
+        if (all(c) || all(not(c))) s = -s;
+    }
+    return s * sqrt(d) / 32.0;
+}
+// Middle of the pointer shape (the pivot when the reflection is warped).
+vec2 pointerCentre(int kind) {
+    return (kind == 2) ? vec2(0.0) : vec2(0.18, 0.31);
+}
+// 0..1 coverage of the pointer at p, softened like a gaussian blur.
+// kind: 1 = arrow, 2 = I-beam
+float pointerShape(vec2 p, int kind, float blur) {
+    float d = (kind == 2) ? sdIBeam(p) : sdArrow(p);
+    return 1.0 - smoothstep(-blur, blur, d);
+}
+
 //!! quad_vertex
 in vec2 position;
 in vec2 tex_coords;
@@ -145,6 +185,13 @@ uniform float screen_brightness;
 uniform float bloom;
 uniform float curvatureOn;
 uniform float bloomOn;
+uniform vec2 viewportSize;
+uniform vec2 pointerPos;     // pointer position in content coordinates
+uniform float pointerSize;   // cursor box in pixels
+uniform int pointerKind;     // 0 = none
