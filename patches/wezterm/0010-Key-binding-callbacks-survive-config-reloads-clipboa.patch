+        // Whether the clipboard holds text.  Lets a Ctrl+V binding hand the
+        // key to the program when there is no text to paste (an image, say).
+        methods.add_method("clipboard_has_text", |_, _this, _: ()| {
+            #[cfg(windows)]
+            {
+                use winapi::um::winuser::{IsClipboardFormatAvailable, CF_UNICODETEXT};
+                // no need to open the clipboard for this
+                return Ok(unsafe { IsClipboardFormatAvailable(CF_UNICODETEXT) } != 0);
+            }
+            #[allow(unreachable_code)]
+            Ok(true)
+        });
         methods.add_async_method("is_focused", |_, this, _: ()| async move {
             let (tx, rx) = smol::channel::bounded(1);
             this.window
diff --git a/wezterm-gui/src/termwindow/mod.rs b/wezterm-gui/src/termwindow/mod.rs
index 7dbe074..2de49f5 100644
--- a/wezterm-gui/src/termwindow/mod.rs
+++ b/wezterm-gui/src/termwindow/mod.rs
@@ -1632,9 +1632,15 @@ impl TermWindow {
             Ok(())
         }
 
-        promise::spawn::spawn(config::with_lua_config_on_main_thread(move |lua| {
-            do_event(lua, name, window, pane)
-        }))
+        // the lua context that registered the handler: key bindings made with
+        // action_callback name a callback of the configuration they came from
+        let event = name.clone();
+        promise::spawn::spawn(async move {
+            config::with_lua_config_for_event_on_main_thread(&event, move |lua| {
+                do_event(lua, name, window, pane)
+            })
+            .await
+        })
         .detach();
     }
 
