+    }
+
     pub fn config_was_reloaded(&mut self) {
+        // the reloaded configuration has the values that were previewed
+        self.crt_preview = None;
         log::debug!(
             "config was reloaded, overrides: {:?}",
             self.config_overrides
@@ -3651,3 +3672,31 @@ impl Drop for TermWindow {
         }
     }
 }
+
+/// `base` with the fields of a CRT preview applied on top (see
+/// TermWindowNotif::SetCrtPreview); None for nil, {} or values that do not fit.
+fn crt_preview_config(
+    base: &config::CrtConfig,
+    preview: wezterm_dynamic::Value,
+) -> Option<config::CrtConfig> {
+    use wezterm_dynamic::{FromDynamic, FromDynamicOptions, ToDynamic, Value};
+    let Value::Object(preview) = preview else {
+        return None;
+    };
+    if preview.is_empty() {
+        return None;
+    }
+    let Value::Object(mut merged) = base.to_dynamic() else {
+        return None;
+    };
+    for (key, value) in preview.iter() {
+        merged.insert(key.clone(), value.clone());
+    }
+    match config::CrtConfig::from_dynamic(&Value::Object(merged), FromDynamicOptions::default()) {
+        Ok(crt) => Some(crt),
+        Err(err) => {
+            log::warn!("CRT preview ignored: {err}");
+            None
+        }
+    }
+}
