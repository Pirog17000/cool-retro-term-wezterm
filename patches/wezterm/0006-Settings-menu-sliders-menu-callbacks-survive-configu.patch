+    /// Left/Right on a slider: move it one step (a fifth of one when `fine`)
+    /// and report the new value, the selector stays open.
+    fn adjust(&mut self, direction: f64, fine: bool) {
+        let Some(entry) = self.filtered_entries.get_mut(self.active_idx) else {
+            return;
+        };
+        let Some(slider) = entry.slider.as_mut() else {
+            return;
+        };
+        let step = if fine && slider.names.is_empty() && slider.step < 1.0 {
+            slider.step / 5.0
+        } else {
+            slider.step
+        };
+        if !(step > 0.0) {
+            return;
+        }
+        let (lo, hi) = (slider.min.min(slider.max), slider.min.max(slider.max));
+        let steps = ((slider.value - lo) / step + direction).round();
+        let value = (lo + steps * step).clamp(lo, hi);
+        let value = (value * 1e6).round() / 1e6;
+        if (value - slider.value).abs() < 1e-9 {
+            return;
+        }
+        slider.value = value;
+        let entry = entry.clone();
+        // keep the value when the filter rebuilds the list
+        for choice in self.args.choices.iter_mut() {
+            if choice.id == entry.id && choice.label == entry.label {
+                choice.slider = entry.slider.clone();
+            }
+        }
+        self.trigger_adjust(entry, value);
+    }
+
+    fn trigger_adjust(&self, entry: InputSelectorEntry, value: f64) {
+        {
+            let mut queue = self.adjusts.lock().unwrap();
+            if queue.busy {
+                queue.pending = Some((entry, value));
+                return;
+            }
+            queue.busy = true;
+        }
+        let name = self.event_name.clone();
+        let window = self.window.clone();
+        let pane = self.pane.clone();
+        let adjusts = Arc::clone(&self.adjusts);
+        promise::spawn::spawn_into_main_thread(async move {
+            promise::spawn::spawn(async move {
+                let mut next = Some((entry, value));
+                while let Some((entry, value)) = next.take() {
+                    let (n, w, p) = (name.clone(), window.clone(), pane.clone());
+                    if let Err(err) =
+                        config::with_lua_config_for_event_on_main_thread(&name, move |lua| {
+                            do_event(lua, n, w, p, Some(entry), Some(value))
+                        })
+                        .await
+                    {
+                        log::error!("while processing {} event: {:#}", name, err);
+                    }
+                    let mut queue = adjusts.lock().unwrap();
+                    next = queue.pending.take();
+                    if next.is_none() {
+                        queue.busy = false;
+                    }
+                }
+            })
+            .detach();
+            anyhow::Result::<()>::Ok(())
+        })
+        .detach();
+    }
