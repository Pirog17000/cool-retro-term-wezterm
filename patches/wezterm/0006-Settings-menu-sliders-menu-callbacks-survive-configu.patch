+/// Slider changes are reported one at a time: while one is being handled
+/// (the handler may reload the configuration) only the latest value waits.
+#[derive(Default)]
+struct AdjustQueue {
+    busy: bool,
+    pending: Option<(InputSelectorEntry, f64)>,
+}
+
+/// The slider bar and its value (or the name of its step).
+fn slider_text(slider: &InputSelectorSlider) -> String {
+    const WIDTH: usize = 20;
+    let (lo, hi) = (slider.min.min(slider.max), slider.min.max(slider.max));
+    let frac = if hi > lo {
+        ((slider.value - lo) / (hi - lo)).clamp(0.0, 1.0)
+    } else {
+        0.0
+    };
+    let filled = (frac * WIDTH as f64).round() as usize;
+    // segments and dots, as on a DOS screen: rows stay apart
+    let bar = format!(
+        "{}{}",
+        "\u{25a0}".repeat(filled),
+        "\u{00b7}".repeat(WIDTH - filled)
+    );
+    let text = if slider.names.is_empty() {
+        let decimals = if slider.step >= 1.0 {
+            0
+        } else if slider.step >= 0.1 {
+            1
+        } else {
+            2
+        };
+        format!("{:.*}", decimals, slider.value)
+    } else {
+        let idx = ((slider.value - lo) / slider.step.max(1e-9)).round().max(0.0) as usize;
+        slider.names.get(idx).cloned().unwrap_or_default()
+    };
+    format!("{bar} {text}")
+}
