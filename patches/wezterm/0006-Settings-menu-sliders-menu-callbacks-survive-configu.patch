 /// and updates LuaConfigState
 struct LuaConfigState {
     lua: Option<Rc<mlua::Lua>>,
+    /// Earlier generations, most recently used first.  A callback created at
+    /// run time (a menu opened from an event handler) only exists in the
+    /// generation that created it; events for it must still reach it after
+    /// the configuration was reloaded.
+    previous: Vec<Rc<mlua::Lua>>,
 }
 
+/// How many earlier lua contexts are kept for their run time callbacks.
+const PREVIOUS_LUA_GENERATIONS: usize = 8;
+
 impl LuaConfigState {
     /// Consume any lua contexts sent to us via the
     /// config loader until we end up with the most
     /// recent one being referenced by LUA_CONFIG.
     fn update_to_latest(&mut self) {
         while let Ok(lua) = LUA_PIPE.receiver.try_recv() {
-            self.lua.replace(Rc::new(lua));
+            if let Some(old) = self.lua.replace(Rc::new(lua)) {
+                self.previous.insert(0, old);
+                self.previous.truncate(PREVIOUS_LUA_GENERATIONS);
+            }
+        }
+    }
+
+    /// The lua context that has a handler for `event`: the latest one, or
+    /// else the earlier generation that registered it (which then counts as
+    /// recently used, so that a menu in use is not dropped).
+    fn get_lua_for_event(&mut self, event: &str) -> Option<Rc<mlua::Lua>> {
+        if let Some(lua) = &self.lua {
+            if lua::has_event_handler(lua, event) {
+                return Some(Rc::clone(lua));
+            }
         }
+        if let Some(idx) = self
+            .previous
+            .iter()
+            .position(|lua| lua::has_event_handler(lua, event))
+        {
+            let lua = self.previous.remove(idx);
+            self.previous.insert(0, Rc::clone(&lua));
+            return Some(lua);
+        }
+        self.get_lua()
     }
 
     /// Take a reference on the latest generation of the lua context
@@ -229,7 +261,10 @@ pub fn designate_this_as_the_main_thread() {
     LUA_CONFIG.with(|lc| {
         let mut lc = lc.borrow_mut();
         if lc.is_none() {
-            lc.replace(LuaConfigState { lua: None });
+            lc.replace(LuaConfigState {
+                lua: None,
+                previous: vec![],
+            });
         }
     });
 }
@@ -279,6 +314,30 @@ where
     func(lua).await
 }
 
+/// Like with_lua_config_on_main_thread, for emitting `event`: uses the lua
+/// context in which its handler was registered, which is an earlier one when
+/// a callback created at run time outlived a configuration reload.
+pub async fn with_lua_config_for_event_on_main_thread<F, RETF, RET>(
+    event: &str,
+    func: F,
+) -> anyhow::Result<RET>
+where
+    F: FnOnce(Option<Rc<mlua::Lua>>) -> RETF,
+    RETF: Future<Output = anyhow::Result<RET>>,
+{
+    let lua = LUA_CONFIG.with(|lc| {
+        let mut lc = lc.borrow_mut();
+        let lc = lc.as_mut().expect(
+            "with_lua_config_for_event_on_main_thread not called
+             from main thread, use with_lua_config instead!",
+        );
+        lc.update_to_latest();
+        lc.get_lua_for_event(event)
+    });
+
+    func(lua).await
+}
+
 pub fn run_immediate_with_lua_config<F, RET>(func: F) -> anyhow::Result<RET>
 where
     F: FnOnce(Option<Rc<mlua::Lua>>) -> anyhow::Result<RET>,
