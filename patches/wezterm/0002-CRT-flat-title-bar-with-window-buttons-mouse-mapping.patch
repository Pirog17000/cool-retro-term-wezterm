+/// Which render layers a scene draw includes.  The fancy tab bar (and the
+/// integrated window buttons inside it) lives on z-index 10..100; panes are
+/// below, modal overlays (palette, char select, ...) are at 100 and above.
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub enum SceneLayers {
+    All,
+    ExceptTabBar,
+    OnlyTabBar,
+}
+
+impl SceneLayers {
+    fn includes(self, zindex: i8) -> bool {
+        let tab_bar = (10..100).contains(&zindex);
+        match self {
+            Self::All => true,
+            Self::ExceptTabBar => !tab_bar,
+            Self::OnlyTabBar => tab_bar,
+        }
+    }
+}
