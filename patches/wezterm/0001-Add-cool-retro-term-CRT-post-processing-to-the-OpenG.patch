diff --git a/config/src/crt.rs b/config/src/crt.rs
new file mode 100644
index 0000000..833e999
--- /dev/null
+++ b/config/src/crt.rs
@@ -0,0 +1,257 @@
+//! CRT post-processing settings (cool-retro-term look) for wezterm.
+//!
+//! ```lua
+//! config.crt = {
+//!   enabled = true,
+//!   profile = "Default Amber",   -- any cool-retro-term built-in profile
+//!   bloom = 0.8,                 -- override any profile value
+//!   font_color = "#33ff66",
+//! }
+//! ```
+use crate::color::RgbaColor;
+use crate::crt_profiles::CRT_PROFILES;
+use wezterm_dynamic::{FromDynamic, ToDynamic};
+
+/// A cool-retro-term profile, in the raw units cool-retro-term stores them.
+#[derive(Debug, Clone, Copy)]
+pub struct CrtProfile {
+    pub name: &'static str,
+    pub font: &'static str,
+    pub ambient_light: f32,
+    pub bloom: f32,
+    pub brightness: f32,
+    pub burn_in: f32,
+    pub chroma_color: f32,
+    pub contrast: f32,
+    pub flickering: f32,
+    pub glowing_line: f32,
+    pub horizontal_sync: f32,
+    pub jitter: f32,
+    pub rgb_shift: f32,
+    pub saturation_color: f32,
+    pub screen_curvature: f32,
+    pub screen_radius: f32,
+    pub static_noise: f32,
+    pub frame_size: f32,
+    pub frame_shininess: f32,
+    pub margin: f32,
+    pub window_opacity: f32,
+    pub line_spacing: f32,
+    pub font_color: (u8, u8, u8),
+    pub background_color: (u8, u8, u8),
+    pub frame_color: (u8, u8, u8),
+    pub rasterization: u8,
+    pub blinking_cursor: bool,
+}
+
+pub fn crt_profiles() -> &'static [CrtProfile] {
+    &CRT_PROFILES
+}
+
+pub fn crt_profile(name: &str) -> Option<&'static CrtProfile> {
+    CRT_PROFILES
+        .iter()
+        .find(|p| p.name.eq_ignore_ascii_case(name))
+}
+
+fn default_profile() -> String {
+    "Default Amber".to_string()
+}
+
+fn default_quality() -> f32 {
+    0.5
+}
+
+fn default_fps() -> u8 {
+    30
+}
+
+fn default_true() -> bool {
+    true
+}
+
+/// `config.crt`: which profile to start from plus optional overrides for
+/// every effect parameter.  Values use cool-retro-term's 0..1 slider units.
+#[derive(Debug, Clone, FromDynamic, ToDynamic)]
+pub struct CrtConfig {
+    #[dynamic(default = "default_true")]
+    pub enabled: bool,
+    #[dynamic(default = "default_profile")]
+    pub profile: String,
+
+    #[dynamic(default)]
+    pub font_color: Option<RgbaColor>,
+    #[dynamic(default)]
+    pub background_color: Option<RgbaColor>,
+    #[dynamic(default)]
+    pub frame_color: Option<RgbaColor>,
+
+    #[dynamic(default)]
+    pub ambient_light: Option<f32>,
+    #[dynamic(default)]
+    pub bloom: Option<f32>,
+    #[dynamic(default)]
+    pub brightness: Option<f32>,
+    #[dynamic(default)]
+    pub burn_in: Option<f32>,
+    #[dynamic(default)]
+    pub chroma_color: Option<f32>,
+    #[dynamic(default)]
+    pub contrast: Option<f32>,
+    #[dynamic(default)]
+    pub flickering: Option<f32>,
+    #[dynamic(default)]
+    pub glowing_line: Option<f32>,
+    #[dynamic(default)]
+    pub horizontal_sync: Option<f32>,
+    #[dynamic(default)]
+    pub jitter: Option<f32>,
+    #[dynamic(default)]
+    pub rgb_shift: Option<f32>,
+    #[dynamic(default)]
+    pub saturation_color: Option<f32>,
+    #[dynamic(default)]
+    pub screen_curvature: Option<f32>,
+    #[dynamic(default)]
+    pub screen_radius: Option<f32>,
+    #[dynamic(default)]
+    pub static_noise: Option<f32>,
+    #[dynamic(default)]
+    pub frame_size: Option<f32>,
+    #[dynamic(default)]
+    pub frame_shininess: Option<f32>,
+    /// 0 = none, 1 = scanlines, 2 = pixels, 3 = sub-pixels, 4 = modern (none)
+    #[dynamic(default)]
+    pub rasterization: Option<u8>,
+
+    /// Size in screen pixels of one emulated "phosphor" pixel, used by the
+    /// rasterization patterns and noise.  Defaults to cell height / 12.
+    #[dynamic(default)]
+    pub pixel_size: Option<f32>,
+
+    /// Resolution of the bloom blur relative to the window (0.25 .. 1).
+    #[dynamic(default = "default_quality")]
+    pub bloom_quality: f32,
+    /// Resolution of the burn-in buffer relative to the window (0.25 .. 1).
+    #[dynamic(default = "default_quality")]
+    pub burn_in_quality: f32,
+    /// Frame rate of the animated effects (noise, flicker, glowing line).
+    #[dynamic(default = "default_fps")]
+    pub fps: u8,
+}
+
+impl Default for CrtConfig {
+    fn default() -> Self {
+        Self {
+            enabled: true,
+            profile: default_profile(),
+            font_color: None,
+            background_color: None,
+            frame_color: None,
+            ambient_light: None,
+            bloom: None,
+            brightness: None,
+            burn_in: None,
+            chroma_color: None,
+            contrast: None,
+            flickering: None,
+            glowing_line: None,
+            horizontal_sync: None,
+            jitter: None,
+            rgb_shift: None,
+            saturation_color: None,
+            screen_curvature: None,
+            screen_radius: None,
+            static_noise: None,
+            frame_size: None,
+            frame_shininess: None,
+            rasterization: None,
+            pixel_size: None,
+            bloom_quality: default_quality(),
+            burn_in_quality: default_quality(),
+            fps: default_fps(),
+        }
+    }
+}
+
+fn rgb_of(c: &Option<RgbaColor>, fallback: (u8, u8, u8)) -> [f32; 3] {
+    match c {
+        Some(c) => {
+            let (r, g, b, _) = c.to_srgb_u8();
+            [r as f32 / 255., g as f32 / 255., b as f32 / 255.]
+        }
+        None => [
+            fallback.0 as f32 / 255.,
+            fallback.1 as f32 / 255.,
+            fallback.2 as f32 / 255.,
+        ],
+    }
+}
+
+/// Fully resolved effect parameters (profile + overrides), still in
+/// cool-retro-term slider units; the renderer derives shader uniforms.
+#[derive(Debug, Clone, Copy)]
+pub struct CrtParams {
+    pub font_color: [f32; 3],
+    pub background_color: [f32; 3],
+    pub frame_color: [f32; 3],
+    pub ambient_light: f32,
+    pub bloom: f32,
+    pub brightness: f32,
+    pub burn_in: f32,
+    pub chroma_color: f32,
+    pub contrast: f32,
+    pub flickering: f32,
+    pub glowing_line: f32,
+    pub horizontal_sync: f32,
+    pub jitter: f32,
+    pub rgb_shift: f32,
+    pub saturation_color: f32,
+    pub screen_curvature: f32,
+    pub screen_radius: f32,
+    pub static_noise: f32,
+    pub frame_size: f32,
+    pub frame_shininess: f32,
+    pub rasterization: u8,
+    pub pixel_size: Option<f32>,
+    pub bloom_quality: f32,
+    pub burn_in_quality: f32,
+    pub fps: u8,
+}
+
+impl CrtConfig {
+    pub fn base_profile(&self) -> &'static CrtProfile {
+        crt_profile(&self.profile).unwrap_or(&CRT_PROFILES[0])
+    }
+
+    pub fn resolve(&self) -> CrtParams {
+        let p = self.base_profile();
+        CrtParams {
+            font_color: rgb_of(&self.font_color, p.font_color),
+            background_color: rgb_of(&self.background_color, p.background_color),
+            frame_color: rgb_of(&self.frame_color, p.frame_color),
+            ambient_light: self.ambient_light.unwrap_or(p.ambient_light),
+            bloom: self.bloom.unwrap_or(p.bloom),
+            brightness: self.brightness.unwrap_or(p.brightness),
+            burn_in: self.burn_in.unwrap_or(p.burn_in),
+            chroma_color: self.chroma_color.unwrap_or(p.chroma_color),
+            contrast: self.contrast.unwrap_or(p.contrast),
+            flickering: self.flickering.unwrap_or(p.flickering),
+            glowing_line: self.glowing_line.unwrap_or(p.glowing_line),
+            horizontal_sync: self.horizontal_sync.unwrap_or(p.horizontal_sync),
+            jitter: self.jitter.unwrap_or(p.jitter),
+            rgb_shift: self.rgb_shift.unwrap_or(p.rgb_shift),
+            saturation_color: self.saturation_color.unwrap_or(p.saturation_color),
+            screen_curvature: self.screen_curvature.unwrap_or(p.screen_curvature),
+            screen_radius: self.screen_radius.unwrap_or(p.screen_radius),
+            static_noise: self.static_noise.unwrap_or(p.static_noise),
+            frame_size: self.frame_size.unwrap_or(p.frame_size),
+            frame_shininess: self.frame_shininess.unwrap_or(p.frame_shininess),
+            rasterization: self.rasterization.unwrap_or(p.rasterization),
+            pixel_size: self.pixel_size,
+            bloom_quality: self.bloom_quality.clamp(0.1, 1.0),
+            burn_in_quality: self.burn_in_quality.clamp(0.1, 1.0),
+            fps: self.fps.clamp(1, 120),
+        }
+    }
+}
