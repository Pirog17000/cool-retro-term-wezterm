diff --git a/wezterm-gui/src/crt/mod.rs b/wezterm-gui/src/crt/mod.rs
new file mode 100644
index 0000000..7f7df64
--- /dev/null
+++ b/wezterm-gui/src/crt/mod.rs
@@ -0,0 +1,393 @@
+//! cool-retro-term style CRT post-processing for the OpenGL front end.
+//!
+//! The terminal is first rendered into an offscreen `scene` texture; then:
+//!
+//! 1. bloom    : scene -> separable gaussian blur at `bloom_quality` scale
+//! 2. burn-in  : max(previous - decay, scene) feedback buffer (ping-pong)
+//! 3. frame    : the CRT bezel / glass reflection layer
+//! 4. static   : curvature, RGB shift, bloom, frame reflection, brightness
+//! 5. dynamic  : noise, jitter, flicker, h-sync, glowing line, burn-in,
+//!               rasterization and phosphor tint -> window
+//!
+//! Shaders live in `shaders.glsl` and are ports of cool-retro-term's.
+
+use ::window::glium;
+use anyhow::Context as _;
+use config::CrtParams;
+use glium::backend::Context as GliumContext;
+use glium::framebuffer::SimpleFrameBuffer;
+use glium::texture::{MipmapsOption, RawImage2d, Texture2d, UncompressedFloatFormat};
+use glium::uniforms::{MagnifySamplerFilter, MinifySamplerFilter, Sampler, SamplerWrapFunction};
+use glium::{Program, Surface, VertexBuffer};
+use std::rc::Rc;
+use std::time::Instant;
+
+const SHADERS: &str = include_str!("shaders.glsl");
+const NOISE_PNG: &[u8] = include_bytes!("allNoise512.png");
+
+#[derive(Copy, Clone)]
+struct QuadVertex {
+    position: [f32; 2],
+    tex_coords: [f32; 2],
+}
+glium::implement_vertex!(QuadVertex, position, tex_coords);
+
+fn section(name: &str) -> anyhow::Result<&'static str> {
+    let marker = format!("//!! {name}\n");
+    let marker_crlf = format!("//!! {name}\r\n");
+    let (start, len) = if let Some(i) = SHADERS.find(&marker) {
+        (i, marker.len())
+    } else if let Some(i) = SHADERS.find(&marker_crlf) {
+        (i, marker_crlf.len())
+    } else {
+        anyhow::bail!("missing shader section {name}");
+    };
+    let body = &SHADERS[start + len..];
+    let end = body.find("//!! ").unwrap_or(body.len());
+    Ok(&body[..end])
+}
+
+fn compile(ctx: &Rc<GliumContext>, vertex: &str, fragment: &str) -> anyhow::Result<Program> {
+    let common = section("common")?;
+    let vs = section(vertex)?;
+    let fs = section(fragment)?;
+    let mut errors = vec![];
+    for version in &["330 core", "330", "320 es", "300 es"] {
+        let vertex_shader = format!("#version {version}\n{common}\n{vs}");
+        let fragment_shader = format!("#version {version}\n{common}\n{fs}");
+        let source = glium::program::ProgramCreationInput::SourceCode {
+            vertex_shader: &vertex_shader,
+            fragment_shader: &fragment_shader,
+            outputs_srgb: true,
+            tessellation_control_shader: None,
+            tessellation_evaluation_shader: None,
+            transform_feedback_varyings: None,
+            uses_point_size: false,
+            geometry_shader: None,
+        };
+        match Program::new(ctx, source) {
+            Ok(p) => return Ok(p),
+            Err(err) => errors.push(format!("{version}: {err:#}")),
+        }
+    }
+    anyhow::bail!("CRT shader {fragment} failed: {}", errors.join("\n"))
+}
+
+fn target(ctx: &Rc<GliumContext>, w: u32, h: u32) -> anyhow::Result<Texture2d> {
+    Ok(Texture2d::empty_with_format(
+        ctx,
+        UncompressedFloatFormat::U8U8U8U8,
+        MipmapsOption::NoMipmap,
+        w.max(1),
+        h.max(1),
+    )?)
+}
+
+fn linear(t: &Texture2d) -> Sampler<'_, Texture2d> {
+    t.sampled()
+        .wrap_function(SamplerWrapFunction::Clamp)
+        .minify_filter(MinifySamplerFilter::Linear)
+        .magnify_filter(MagnifySamplerFilter::Linear)
+}
+
+fn mix3(a: [f32; 3], b: [f32; 3], t: f32) -> [f32; 3] {
+    [
+        a[0] * (1. - t) + b[0] * t,
+        a[1] * (1. - t) + b[1] * t,
+        a[2] * (1. - t) + b[2] * t,
+    ]
+}
+
+fn lint(a: f32, b: f32, t: f32) -> f32 {
+    (1. - t) * a + t * b
+}
+
+fn smoothstep(min: f32, max: f32, v: f32) -> f32 {
+    let x = ((v - min) / (max - min)).clamp(0., 1.);
+    x * x * (3. - 2. * x)
+}
+
+struct Targets {
+    size: (u32, u32),
+    bloom_size: (u32, u32),
+    burn_size: (u32, u32),
+    scene: Texture2d,
+    static_out: Texture2d,
+    frame: Texture2d,
+    bloom_a: Texture2d,
+    bloom_b: Texture2d,
+    burn: [Texture2d; 2],
+}
+
+pub struct CrtRenderer {
+    ctx: Rc<GliumContext>,
+    quad: VertexBuffer<QuadVertex>,
+    blur: Program,
+    burn_in: Program,
+    frame: Program,
+    stat: Program,
+    dynamic: Program,
+    noise: Texture2d,
+    targets: Option<Targets>,
+    burn_idx: usize,
+    start: Instant,
+    last_burn_time: f32,
+}
+
+impl CrtRenderer {
+    pub fn new(ctx: &Rc<GliumContext>) -> anyhow::Result<Self> {
+        // Full screen quad; tex_coords are logical (0,0 = top left).
+        let quad = VertexBuffer::new(
+            ctx,
+            &[
+                QuadVertex { position: [-1., 1.], tex_coords: [0., 0.] },
+                QuadVertex { position: [1., 1.], tex_coords: [1., 0.] },
+                QuadVertex { position: [-1., -1.], tex_coords: [0., 1.] },
+                QuadVertex { position: [1., -1.], tex_coords: [1., 1.] },
+            ],
+        )?;
+
+        let img = image::load_from_memory(NOISE_PNG)
+            .context("decode CRT noise texture")?
+            .to_rgba8();
+        let dims = img.dimensions();
+        let raw = RawImage2d::from_raw_rgba(img.into_raw(), dims);
+        let noise = Texture2d::with_format(
+            ctx,
+            raw,
+            UncompressedFloatFormat::U8U8U8U8,
+            MipmapsOption::NoMipmap,
+        )?;
+
+        Ok(Self {
+            ctx: Rc::clone(ctx),
+            quad,
+            blur: compile(ctx, "quad_vertex", "blur_fragment")?,
+            burn_in: compile(ctx, "quad_vertex", "burn_in_fragment")?,
+            frame: compile(ctx, "quad_vertex", "frame_fragment")?,
+            stat: compile(ctx, "quad_vertex", "static_fragment")?,
+            dynamic: compile(ctx, "dynamic_vertex", "dynamic_fragment")?,
+            noise,
+            targets: None,
+            burn_idx: 0,
+            start: Instant::now(),
+            last_burn_time: 0.,
+        })
+    }
+
+    pub fn is_for_context(&self, ctx: &Rc<GliumContext>) -> bool {
+        Rc::ptr_eq(&self.ctx, ctx)
+    }
+
+    fn ensure_targets(&mut self, w: u32, h: u32, p: &CrtParams) -> anyhow::Result<()> {
+        let bloom_size = (
+            ((w as f32) * p.bloom_quality).max(1.) as u32,
+            ((h as f32) * p.bloom_quality).max(1.) as u32,
+        );
+        let burn_size = (
+            ((w as f32) * p.burn_in_quality).max(1.) as u32,
+            ((h as f32) * p.burn_in_quality).max(1.) as u32,
+        );
+        if let Some(t) = &self.targets {
+            if t.size == (w, h) && t.bloom_size == bloom_size && t.burn_size == burn_size {
+                return Ok(());
+            }
+        }
+        let ctx = &self.ctx;
+        let burn = [
+            target(ctx, burn_size.0, burn_size.1)?,
+            target(ctx, burn_size.0, burn_size.1)?,
+        ];
+        for b in &burn {
+            SimpleFrameBuffer::new(ctx, b)?.clear_color(0., 0., 0., 0.);
+        }
+        self.targets = Some(Targets {
+            size: (w, h),
+            bloom_size,
+            burn_size,
+            scene: target(ctx, w, h)?,
+            static_out: target(ctx, w, h)?,
+            frame: target(ctx, w, h)?,
+            bloom_a: target(ctx, bloom_size.0, bloom_size.1)?,
+            bloom_b: target(ctx, bloom_size.0, bloom_size.1)?,
+            burn,
+        });
+        self.burn_idx = 0;
+        self.last_burn_time = self.start.elapsed().as_secs_f32();
+        Ok(())
+    }
+
+    /// Returns a framebuffer the terminal should be rendered into.
+    pub fn scene_target(&mut self, w: u32, h: u32, p: &CrtParams) -> anyhow::Result<SimpleFrameBuffer<'_>> {
+        self.ensure_targets(w, h, p)?;
+        let t = self.targets.as_ref().unwrap();
+        Ok(SimpleFrameBuffer::new(&self.ctx, &t.scene)?)
+    }
+
+    /// Runs all CRT passes over the scene rendered via scene_target() and
+    /// draws the result into `frame`.
+    pub fn render(&mut self, frame: &mut glium::Frame, p: &CrtParams, cell_height: f32) -> anyhow::Result<()> {
+        let Some(t) = self.targets.as_ref() else {
+            return Ok(());
+        };
+        let ctx = &self.ctx;
+        let (w, h) = t.size;
+        let (wf, hf) = (w as f32, h as f32);
+        let time = self.start.elapsed().as_secs_f32();
+        let strip = glium::index::NoIndices(glium::index::PrimitiveType::TriangleStrip);
+        let params = glium::DrawParameters::default();
+
+        // ---- derived values (mirrors cool-retro-term's QML bindings) -----
+        let normalized_window_scale = 1024.0 / (0.5 * wf + 0.5 * hf);
+        let screen_curvature = p.screen_curvature * 0.6 * normalized_window_scale;
+        let frame_size = p.frame_size * 0.05 * normalized_window_scale;
+        let frame_shininess = p.frame_shininess * 0.5;
+        let screen_radius = lint(4.0, 120.0, p.screen_radius);
+        let bloom = if p.bloom > 0. { p.bloom * 2.5 } else { 0. };
+        let frame_on = p.ambient_light > 0. || p.frame_size > 0. || p.screen_curvature > 0.;
+        let curvature_on = p.screen_curvature > 0. || p.frame_size > 0.;
+        let bloom_on = p.bloom > 0. || p.frame_shininess > 0.;
+
+        let white = [1.0f32, 1.0, 1.0];
+        let saturated = mix3(p.font_color, white, p.saturation_color * 0.5);
+        let k = 0.7 + p.contrast * 0.3;
+        let font_color = mix3(p.background_color, saturated, k);
+        let background_color = mix3(saturated, p.background_color, k);
+        let light = mix3(font_color, background_color, 0.2);
+        let static_frame = [
+            (p.frame_color[0] + 0.1).min(1.),
+            (p.frame_color[1] + 0.1).min(1.),
+            (p.frame_color[2] + 0.1).min(1.),
+        ];
+        let scaled_light = [
+            (light[0] * 0.2).min(1.),
+            (light[1] * 0.2).min(1.),
+            (light[2] * 0.2).min(1.),
+        ];
+        let frame_color = mix3(scaled_light, static_frame, 0.125 + 0.750 * p.ambient_light);
+
+        let pixel = p.pixel_size.unwrap_or((cell_height / 6.0).max(1.0)).max(1.0);
+        let virtual_resolution = [wf / pixel, hf / pixel];
+        let rasterization_intensity = smoothstep(2.0, 4.0, pixel);
+        let scale_noise_size = [wf * 0.75 / 512.0, hf * 0.75 / 512.0];
+        let jitter_displacement = [0.007 * p.jitter, 0.002 * p.jitter];
+        let horizontal_sync_strength = lint(0.05, 0.35, p.horizontal_sync);
+        let glowing_line = p.glowing_line * 0.2;
+        let burn_in_time = 1.0 / lint(0.16, 1.6, p.burn_in);
+        let rgb_shift = p.rgb_shift * (4.0 / wf);
+        let screen_brightness = lint(0.5, 1.5, p.brightness);
+
+        // ---- 1. bloom ------------------------------------------------------
+        if bloom_on {
+            let (bw, bh) = t.bloom_size;
+            let radius = lint(16.0, 64.0, p.bloom_quality) * p.bloom_quality.max(0.25);
+            {
+                let src = linear(&t.scene);
+                let dir = [1.0 / bw as f32, 0.0f32];
+                let u = glium::uniform! { source: src, direction: dir, radius: radius };
+                SimpleFrameBuffer::new(ctx, &t.bloom_a)?.draw(&self.quad, strip, &self.blur, &u, &params)?;
+            }
+            {
+                let src = linear(&t.bloom_a);
+                let dir = [0.0f32, 1.0 / bh as f32];
+                let u = glium::uniform! { source: src, direction: dir, radius: radius };
+                SimpleFrameBuffer::new(ctx, &t.bloom_b)?.draw(&self.quad, strip, &self.blur, &u, &params)?;
+            }
+        }
+
+        // ---- 2. burn-in ------------------------------------------------------
+        if p.burn_in > 0. {
+            let prev = self.burn_idx;
+            let next = 1 - prev;
+            let u = glium::uniform! {
+                txt_source: linear(&t.scene),
+                burnInSource: linear(&t.burn[prev]),
+                burnInLastUpdate: time,
+                burnInTime: burn_in_time,
+                prevLastUpdate: self.last_burn_time,
+            };
+            SimpleFrameBuffer::new(ctx, &t.burn[next])?.draw(&self.quad, strip, &self.burn_in, &u, &params)?;
+            self.burn_idx = next;
+            self.last_burn_time = time;
+        }
+        let burn_tex = &t.burn[self.burn_idx];
+
+        // ---- 3. frame ------------------------------------------------------
+        if frame_on {
+            let u = glium::uniform! {
+                screenCurvature: screen_curvature,
+                frameColor: frame_color,
+                frameSize: frame_size,
+                screenRadius: screen_radius,
+                viewportSize: [wf, hf],
+                ambientLight: p.ambient_light,
+                frameShininess: frame_shininess,
+            };
+            SimpleFrameBuffer::new(ctx, &t.frame)?.draw(&self.quad, strip, &self.frame, &u, &params)?;
+        }
+
+        // ---- 4. static -----------------------------------------------------
+        {
+            let u = glium::uniform! {
+                source: linear(&t.scene),
+                bloomSource: linear(&t.bloom_b),
+                screenCurvature: screen_curvature,
+                rgbShift: rgb_shift,
+                frameShininess: frame_shininess,
+                frameSize: frame_size,
+                screen_brightness: screen_brightness,
+                bloom: bloom,
+                curvatureOn: if curvature_on { 1.0f32 } else { 0.0 },
+                bloomOn: if bloom_on { 1.0f32 } else { 0.0 },
+            };
+            SimpleFrameBuffer::new(ctx, &t.static_out)?.draw(&self.quad, strip, &self.stat, &u, &params)?;
+        }
+
+        // ---- 5. dynamic -> window -----------------------------------------
+        {
+            let noise = self
+                .noise
+                .sampled()
+                .wrap_function(SamplerWrapFunction::Repeat)
+                .minify_filter(MinifySamplerFilter::Linear)
+                .magnify_filter(MagnifySamplerFilter::Linear);
+            let mut u = crate::uniforms::UniformBuilder::default();
+            let screen = linear(&t.static_out);
+            let burn = linear(burn_tex);
+            let frame_src = linear(&t.frame);
+            let raster_mode = p.rasterization as i32;
+            let burn_in = p.burn_in;
+            let frame_on_f = if frame_on { 1.0f32 } else { 0.0 };
+            let tint_on = 1.0f32;
+            u.add("noiseSource", &noise);
+            u.add("screenBuffer", &screen);
+            u.add("burnInSource", &burn);
+            u.add("frameSource", &frame_src);
+            u.add("time", &time);
+            u.add("fontColor", &font_color);
+            u.add("backgroundColor", &background_color);
+            u.add("virtualResolution", &virtual_resolution);
+            u.add("rasterizationIntensity", &rasterization_intensity);
+            u.add("rasterMode", &raster_mode);
+            u.add("burnInLastUpdate", &time);
+            u.add("burnInTime", &burn_in_time);
+            u.add("burnIn", &burn_in);
+            u.add("staticNoise", &p.static_noise);
+            u.add("screenCurvature", &screen_curvature);
+            u.add("glowingLine", &glowing_line);
+            u.add("chromaColor", &p.chroma_color);
+            u.add("jitterDisplacement", &jitter_displacement);
+            u.add("jitter", &p.jitter);
+            u.add("flickering", &p.flickering);
+            u.add("horizontalSync", &p.horizontal_sync);
+            u.add("horizontalSyncStrength", &horizontal_sync_strength);
+            u.add("scaleNoiseSize", &scale_noise_size);
+            u.add("frameSize", &frame_size);
+            u.add("bloom", &bloom);
+            u.add("frameOn", &frame_on_f);
+            u.add("tintOn", &tint_on);
+            frame.draw(&self.quad, strip, &self.dynamic, &u, &params)?;
+        }
+        Ok(())
+    }
+}
diff --git a/wezterm-gui/src/crt/shaders.glsl b/wezterm-gui/src/crt/shaders.glsl
new file mode 100644
index 0000000..355bd0d
--- /dev/null
+++ b/wezterm-gui/src/crt/shaders.glsl
@@ -0,0 +1,380 @@
+// CRT post-processing shaders, ported from cool-retro-term
+// (https://github.com/Swordfish90/cool-retro-term, GPL-3.0) to GLSL 330.
+//
+// This file is split into sections by "//!! name" markers; crt/mod.rs
+// extracts each section and prefixes it with the shared header below.
+//
+// Coordinate convention: `tc` is a logical coordinate with (0,0) at the top
+// left of the window (as in Qt).  Offscreen textures are stored GL style
+// (row 0 at the bottom), so they are always sampled through tx().
+
+//!! common
+precision highp float;
+
+vec4 tx(sampler2D s, vec2 c) { return texture(s, vec2(c.x, 1.0 - c.y)); }
+float min2(vec2 v) { return min(v.x, v.y); }
+float max2(vec2 v) { return max(v.x, v.y); }
+float prod2(vec2 v) { return v.x * v.y; }
+float rgb2grey(vec3 v) { return dot(v, vec3(0.21, 0.72, 0.04)); }
+float rand2(vec2 v) { return fract(sin(dot(v, vec2(12.9898, 78.233))) * 43758.5453); }
+
+//!! quad_vertex
+in vec2 position;
+in vec2 tex_coords;
+out vec2 tc;
+void main() {
+    tc = tex_coords;
+    gl_Position = vec4(position, 0.0, 1.0);
+}
+
+//!! blur_fragment
+// Separable gaussian blur (cool-retro-term uses Qt's FastBlur for bloom).
+in vec2 tc;
+out vec4 color;
+uniform sampler2D source;
+uniform vec2 direction;   // one texel step along the blur axis, in uv units
+uniform float radius;     // blur radius in texels
+void main() {
+    const int TAPS = 12;
+    float sigma = max(radius / 2.5, 0.5);
+    float step_size = max(radius / float(TAPS), 1.0);
+    vec4 acc = tx(source, tc);
+    float wsum = 1.0;
+    for (int i = 1; i <= TAPS; i++) {
+        float off = float(i) * step_size;
+        float w = exp(-0.5 * (off * off) / (sigma * sigma));
+        acc += w * tx(source, tc + direction * off);
+        acc += w * tx(source, tc - direction * off);
+        wsum += 2.0 * w;
+    }
+    color = acc / wsum;
+}
+
+//!! burn_in_fragment
+in vec2 tc;
+out vec4 color;
+uniform sampler2D txt_source;
+uniform sampler2D burnInSource;
+uniform float burnInLastUpdate;
+uniform float burnInTime;
+uniform float prevLastUpdate;
+void main() {
+    vec3 txtColor = tx(txt_source, tc).rgb;
+    vec4 accColor = tx(burnInSource, tc);
+    float prevMask = accColor.a;
+    float blurDecay = clamp((burnInLastUpdate - prevLastUpdate) * burnInTime, 0.0, 1.0);
+    blurDecay = max(0.0, blurDecay - prevMask);
+    vec3 c = max(accColor.rgb - vec3(blurDecay), txtColor);
+    float currMask = step(rgb2grey(c), rgb2grey(txtColor));
+    color = vec4(c, currMask);
+}
+
+//!! frame_fragment
+in vec2 tc;
+out vec4 color;
+uniform float screenCurvature;
+uniform vec3 frameColor;
+uniform float frameSize;
+uniform float screenRadius;
+uniform vec2 viewportSize;
+uniform float ambientLight;
+uniform float frameShininess;
+
+vec2 distortCoordinates(vec2 coords) {
+    vec2 paddedCoords = coords * (vec2(1.0) + frameSize * 2.0) - frameSize;
+    vec2 cc = (paddedCoords - vec2(0.5));
+    float dist = dot(cc, cc) * screenCurvature;
+    return (paddedCoords + cc * (1.0 + dist) * dist);
+}
+
+float roundedRectSdfPixels(vec2 p, vec2 topLeft, vec2 bottomRight, float radiusPixels) {
+    vec2 sizePixels = (bottomRight - topLeft) * viewportSize;
+    vec2 centerPixels = (topLeft + bottomRight) * 0.5 * viewportSize;
+    vec2 localPixels = p * viewportSize - centerPixels;
+    vec2 halfSize = sizePixels * 0.5 - vec2(radiusPixels);
+    vec2 d = abs(localPixels) - halfSize;
+    return length(max(d, vec2(0.0))) + min(max(d.x, d.y), 0.0) - radiusPixels;
+}
+
+void main() {
+    vec2 staticCoords = tc;
+    vec2 coords = distortCoordinates(staticCoords);
+
+    float screenRadiusPixels = screenRadius;
+    float edgeSoftPixels = 1.0;
+    float seamWidth = max(screenRadiusPixels, 0.5) / min2(viewportSize);
+
+    float e = min(smoothstep(-seamWidth, seamWidth, coords.x - coords.y),
+                  smoothstep(-seamWidth, seamWidth, coords.x - (1.0 - coords.y)));
+    float s = min(smoothstep(-seamWidth, seamWidth, coords.y - coords.x),
+                  smoothstep(-seamWidth, seamWidth, coords.x - (1.0 - coords.y)));
+    float w = min(smoothstep(-seamWidth, seamWidth, coords.y - coords.x),
+                  smoothstep(-seamWidth, seamWidth, (1.0 - coords.x) - coords.y));
+    float n = min(smoothstep(-seamWidth, seamWidth, coords.x - coords.y),
+                  smoothstep(-seamWidth, seamWidth, (1.0 - coords.x) - coords.y));
+
+    float distPixels = roundedRectSdfPixels(coords, vec2(0.0), vec2(1.0), screenRadiusPixels);
+    float frameShadow = (e * 0.66 + w * 0.66 + n * 0.33 + s);
+    frameShadow *= smoothstep(0.0, edgeSoftPixels * 5.0, distPixels);
+
+    float frameAlpha = 1.0 - frameShininess * 0.4;
+
+    float inScreen = smoothstep(0.0, edgeSoftPixels, -distPixels);
+    float alpha = mix(frameAlpha, mix(0.0, 0.3, ambientLight), inScreen);
+    float glass = clamp(ambientLight * pow(prod2(coords * (1.0 - coords.yx)) * 25.0, 0.5) * inScreen, 0.0, 1.0);
+    vec3 frameTint = frameColor * frameShadow;
+    float noise = rand2(staticCoords * viewportSize) - 0.5;
+    frameTint = clamp(frameTint + vec3(noise * 0.04), 0.0, 1.0);
+    vec3 c = mix(frameTint, vec3(glass), inScreen);
+
+    color = vec4(c, alpha);
+}
+
+//!! static_fragment
+in vec2 tc;
+out vec4 color;
+uniform sampler2D source;
+uniform sampler2D bloomSource;
+uniform float screenCurvature;
+uniform float rgbShift;
+uniform float frameShininess;
+uniform float frameSize;
+uniform float screen_brightness;
+uniform float bloom;
+uniform float curvatureOn;
+uniform float bloomOn;
+
+vec2 distortCoordinates(vec2 coords) {
+    vec2 paddedCoords = coords * (vec2(1.0) + frameSize * 2.0) - frameSize;
+    vec2 cc = (paddedCoords - vec2(0.5));
+    float dist = dot(cc, cc) * screenCurvature;
+    return (paddedCoords + cc * (1.0 + dist) * dist);
+}
+
+void main() {
+    float shownDraw = 1.0;
+    float isReflection = 0.0;
+    float isScreen = 1.0;
+
+    vec2 txt_coords = tc;
+    if (curvatureOn > 0.5) {
+        vec2 curvatureCoords = distortCoordinates(tc);
+        shownDraw = max2(step(vec2(0.0), curvatureCoords) - step(vec2(1.0), curvatureCoords));
+        isScreen = min2(step(vec2(0.0), curvatureCoords) - step(vec2(1.0), curvatureCoords));
+        isReflection = shownDraw - isScreen;
+        txt_coords = curvatureCoords * (-1.0 + 2.0 * step(vec2(0.0), curvatureCoords)
+                                       - 2.0 * step(vec2(1.0), curvatureCoords));
+    }
+
+    vec3 txt_color = tx(source, txt_coords).rgb;
+
+    if (rgbShift > 0.0) {
+        vec2 displacement = vec2(rgbShift, 0.0);
+        vec3 rightColor = tx(source, txt_coords + displacement).rgb;
+        vec3 leftColor = tx(source, txt_coords - displacement).rgb;
+        txt_color.r = leftColor.r * 0.10 + rightColor.r * 0.30 + txt_color.r * 0.60;
+        txt_color.g = leftColor.g * 0.20 + rightColor.g * 0.20 + txt_color.g * 0.60;
+        txt_color.b = leftColor.b * 0.30 + rightColor.b * 0.10 + txt_color.b * 0.60;
+    }
+
+    vec3 finalColor = txt_color * shownDraw;
+
+    vec3 bloomColor = txt_color;
+    float bloomAlpha = 0.0;
+    if (bloomOn > 0.5) {
+        vec4 bloomFullColor = tx(bloomSource, txt_coords);
+        bloomColor = bloomFullColor.rgb;
+        bloomAlpha = bloomFullColor.a;
+    }
+
+    if (bloom > 0.0) {
+        vec3 bloomOnScreen = bloomColor * isScreen;
+        finalColor += clamp(bloomOnScreen * bloom * bloomAlpha, 0.0, 0.5);
+        float bloomScale = 1.0 + max(bloom, 0.0);
+        finalColor /= bloomScale;
+    }
+
+    if (frameShininess > 0.0) {
+        vec3 reflectionColor = mix(bloomColor * bloomAlpha * 2.0, finalColor, frameShininess * 0.5);
+        finalColor = mix(finalColor, reflectionColor, isReflection);
+    }
+
+    finalColor *= screen_brightness;
+
+    float noise = rand2(tc) - 0.5;
+    finalColor = clamp(finalColor + vec3(noise * 0.025), 0.0, 1.0);
+
+    color = vec4(finalColor, 1.0);
+}
+
+//!! dynamic_vertex
+in vec2 position;
+in vec2 tex_coords;
+out vec2 tc;
+out float vBrightness;
+out float vDistortionScale;
+out float vDistortionFreq;
+uniform sampler2D noiseSource;
+uniform float time;
+uniform float flickering;
+uniform float horizontalSync;
+uniform float horizontalSyncStrength;
+void main() {
+    tc = tex_coords;
+
+    vec2 coords = vec2(fract(time / 2.048), fract(time / 1048.576));
+    vec4 initialNoiseTexel = texture(noiseSource, coords);
+
+    vBrightness = 1.0 + (initialNoiseTexel.g - 0.5) * flickering;
+
+    float randval = horizontalSyncStrength - initialNoiseTexel.r;
+    vDistortionScale = step(0.0, randval) * randval * horizontalSyncStrength * horizontalSync;
+    vDistortionFreq = mix(4.0, 40.0, initialNoiseTexel.g) * step(0.0, horizontalSync);
+
+    gl_Position = vec4(position, 0.0, 1.0);
+}
+
+//!! dynamic_fragment
+in vec2 tc;
+in float vBrightness;
+in float vDistortionScale;
+in float vDistortionFreq;
+out vec4 color;
+
+uniform sampler2D noiseSource;
+uniform sampler2D screenBuffer;
+uniform sampler2D burnInSource;
+uniform sampler2D frameSource;
+
+uniform float time;
+uniform vec3 fontColor;
+uniform vec3 backgroundColor;
+uniform vec2 virtualResolution;
+uniform float rasterizationIntensity;
+uniform int rasterMode;
+uniform float burnInLastUpdate;
+uniform float burnInTime;
+uniform float burnIn;
+uniform float staticNoise;
+uniform float screenCurvature;
+uniform float glowingLine;
+uniform float chromaColor;
+uniform vec2 jitterDisplacement;
+uniform float jitter;
+uniform float flickering;
+uniform vec2 scaleNoiseSize;
+uniform float frameSize;
+uniform float bloom;
+uniform float frameOn;
+uniform float tintOn;
+
+vec2 distortCoordinates(vec2 coords) {
+    vec2 paddedCoords = coords * (vec2(1.0) + frameSize * 2.0) - frameSize;
+    vec2 cc = (paddedCoords - vec2(0.5));
+    float dist = dot(cc, cc) * screenCurvature;
+    return (paddedCoords + cc * (1.0 + dist) * dist);
+}
+
+vec3 applyRasterization(vec2 screenCoords, vec3 texel, vec2 virtualRes, float intensity) {
+    if (rasterMode == 0 || rasterMode >= 4 || intensity <= 0.0) {
+        return texel;
+    }
+    const float INTENSITY = 0.30;
+    const float BRIGHTBOOST = 0.30;
+
+    if (rasterMode == 1) {
+        vec3 pixelHigh = ((1.0 + BRIGHTBOOST) - (0.2 * texel)) * texel;
+        vec3 pixelLow  = ((1.0 - INTENSITY) + (0.1 * texel)) * texel;
+        vec2 coords = fract(screenCoords * virtualRes) * 2.0 - vec2(1.0);
+        float mask = 1.0 - abs(coords.y);
+        vec3 rasterizationColor = mix(pixelLow, pixelHigh, mask);
+        return mix(texel, rasterizationColor, intensity);
+    } else if (rasterMode == 2) {
+        vec3 pixelHigh = ((1.0 + BRIGHTBOOST) - (0.2 * texel)) * texel;
+        vec3 pixelLow  = ((1.0 - INTENSITY) + (0.1 * texel)) * texel;
+        vec2 coords = fract(screenCoords * virtualRes) * 2.0 - vec2(1.0);
+        coords = coords * coords;
+        float mask = 1.0 - coords.x - coords.y;
+        vec3 rasterizationColor = mix(pixelLow, pixelHigh, mask);
+        return mix(texel, rasterizationColor, intensity);
+    } else {
+        const float SUBPIXELS = 3.0;
+        vec3 offsets = vec3(3.141592654) * vec3(0.5, 0.5 - 2.0 / 3.0, 0.5 - 4.0 / 3.0);
+        vec2 omega = vec2(3.141592654) * vec2(2.0) * virtualRes;
+        vec2 angle = screenCoords * omega;
+        vec3 xfactors = (SUBPIXELS + sin(angle.x + offsets)) / (SUBPIXELS + 1.0);
+        vec3 result = texel * xfactors;
+        vec3 pixelHigh = ((1.0 + BRIGHTBOOST) - (0.2 * result)) * result;
+        vec3 pixelLow  = ((1.0 - INTENSITY) + (0.1 * result)) * result;
+        vec2 coords = fract(screenCoords * virtualRes) * 2.0 - vec2(1.0);
+        float mask = 1.0 - abs(coords.y);
+        vec3 rasterizationColor = mix(pixelLow, pixelHigh, mask);
+        return mix(texel, rasterizationColor, intensity);
+    }
+}
+
+float randomPass(vec2 coords) {
+    return fract(smoothstep(-120.0, 0.0, coords.y - (virtualResolution.y + 120.0) * fract(time * 0.15)));
+}
+
+vec3 convertWithChroma(vec3 inColor) {
+    if (tintOn < 0.5) {
+        return inColor;
+    }
+    if (chromaColor > 0.0) {
+        float grey = rgb2grey(inColor);
+        float denom = max(grey, 0.0001);
+        vec3 foregroundColor = mix(fontColor, inColor * fontColor / denom, chromaColor);
+        return mix(backgroundColor, foregroundColor, grey);
+    }
+    return mix(backgroundColor, fontColor, rgb2grey(inColor));
+}
+
+void main() {
+    vec2 cc = vec2(0.5) - tc;
+    float distance = length(cc);
+
+    vec2 staticCoords = distortCoordinates(tc);
+    vec2 coords = tc;
+
+    float dst = sin((coords.y + time) * vDistortionFreq);
+    coords.x += dst * vDistortionScale;
+
+    vec4 noiseTexel = texture(noiseSource, scaleNoiseSize * coords + vec2(fract(time / 0.051), fract(time / 0.237)));
+
+    vec2 txt_coords = coords + (noiseTexel.ba - vec2(0.5)) * jitterDisplacement * jitter;
+
+    float c = 0.0001;
+    c += noiseTexel.a * staticNoise * (1.0 - distance * 1.3);
+    c += randomPass(coords * virtualResolution) * glowingLine;
+
+    vec4 frameColor = vec4(0.0);
+    if (frameOn > 0.5) {
+        frameColor = tx(frameSource, tc);
+        c *= (1.0 - frameColor.a);
+    }
+
+    vec3 txt_color = tx(screenBuffer, txt_coords).rgb;
+    float bloomScale = 1.0 + max(bloom, 0.0);
+    txt_color *= bloomScale;
+
+    if (burnIn > 0.0) {
+        vec4 txt_blur = tx(burnInSource, staticCoords);
+        float blurDecay = clamp((time - burnInLastUpdate) * burnInTime, 0.0, 1.0);
+        vec3 burnInColor = 0.65 * (txt_blur.rgb - vec3(blurDecay)) * (1.0 - txt_blur.a);
+        txt_color = max(txt_color, burnInColor);
+    }
+
+    txt_color += vec3(c);
+    txt_color = applyRasterization(staticCoords, txt_color, virtualResolution, rasterizationIntensity);
+
+    vec3 finalColor = convertWithChroma(txt_color);
+    float brightness = mix(1.0, vBrightness, step(0.0, flickering));
+    finalColor *= brightness;
+
+    if (frameOn > 0.5) {
+        finalColor = mix(finalColor, frameColor.rgb, frameColor.a);
+    }
+
+    color = vec4(finalColor, 1.0);
+}
