// Windows resources: application icon and version info
#include <winver.h>

IDI_ICON1 ICON "icons/cool-retro-term.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,2,0,0
 PRODUCTVERSION 1,2,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "cool-retro-term (WezTerm core)"
            VALUE "ProductName", "cool-retro-term"
            VALUE "FileVersion", "1.2.0-wezterm"
            VALUE "ProductVersion", "1.2.0-wezterm"
            VALUE "OriginalFilename", "cool-retro-term.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
